# Database (Prisma) — PostgreSQL on Supabase.
# Supabase dashboard -> Connect -> ORMs -> Prisma. Two strings are needed:
#   DATABASE_URL: Transaction pooler (port 6543). Used by the running app / Vercel.
#   DIRECT_URL:   Session pooler or direct connection (port 5432). Used for prisma db push.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Session signing secret — change in production
SESSION_SECRET="change-me-to-a-random-32-char-min-secret"

# Microsoft 365 SMTP — used to send contact form enquiries via smtp.office365.com.
# SMTP_USER/SMTP_PASS authenticate the mailbox; EMAIL_FROM must be a mailbox that
# account is permitted to send as. EMAIL_TO is a comma-separated recipient list.
SMTP_USER=dev5@flowtech.africa
SMTP_PASS=your_m365_app_password_here
EMAIL_FROM=dev5@flowtech.africa
EMAIL_TO=dev5@flowtech.africa,dev4@flowtech.africa
